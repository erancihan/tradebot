# Copy to `.env` and fill in. NEVER commit your real .env (it is gitignored).
#
# tradebot reads the `.env` in the working directory (where it starts) and
# nowhere else. Only these keys are read from this file; any other line is
# ignored, and a variable already set in the environment wins:
#   ALPACA_API_KEY ALPACA_API_SECRET ALPACA_DATA_FEED TRADEBOT_WEB_TOKEN
#   TRADEBOT_ALLOWED_HOSTS TRADEBOT_LIVE_CONFIRM TRADEBOT_DB TRADEBOT_ARENA_DB
#   TRADEBOT_SEASON_DB TRADEBOT_CONFIG
# TRADEBOT_CONFIG names the config file for `tradebot` and `tradebot-web`
# (a --config flag wins). TRADEBOT_DB names tradebot-web's database (a
# --trading-db flag wins); unset, it is the config's db_path, as for `tradebot`.
#
# Get free API keys from https://app.alpaca.markets/ -> "Paper Trading" ->
# "Generate API Keys". Paper keys cannot touch real money.

ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here

# Data feed: "iex" (free) or "sip" (paid, full-market). Start with iex.
ALPACA_DATA_FEED=iex

# Live-trading safety latch. Leave UNSET for paper trading. Only set this to
# the exact value below when you have switched mode: live in config.yaml AND
# you genuinely intend to risk real money.
# TRADEBOT_LIVE_CONFIRM=I_UNDERSTAND
